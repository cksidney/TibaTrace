{
  "name": "@dawatrace/pos-windows",
  "version": "0.1.0-alpha.1",
  "private": true,
  "type": "module",
  "description": "DawaTrace / TibaTrace Windows POS (Electron)",
  "main": "dist/main/main.js",
  "scripts": {
    "typecheck": "tsc --project tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "build:renderer": "vite build",
    "build:main": "tsc --project tsconfig.main.json",
    "build": "npm run build:main && npm run build:renderer",
    "dev": "vite",
    "start": "electron .",
    "typecheck:visual": "tsc --project tsconfig.visual.json --noEmit",
    "visual:build": "vite build --config vite.visual.config.ts",
    "visual:serve": "npm run visual:build && vite preview --config vite.visual.config.ts",
    "visual": "playwright test",
    "visual:update": "playwright test --update-snapshots"
  },
  "dependencies": {
    "@dawatrace/shared": "*"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "electron": "^43.2.0",
    "jsdom": "25.0.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "typescript": "5.7.3",
    "vite": "^8.1.5",
    "vitest": "^4.1.10"
  }
}
