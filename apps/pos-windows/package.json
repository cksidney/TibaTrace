{
  "name": "@dawatrace/pos-windows",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "TibaTrace POS (Electron) \u2014 clinical dispensing and pharmacy operations console",
  "main": "dist/main/main.js",
  "scripts": {
    "typecheck": "tsc --project tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "build:renderer": "vite build",
    "build:main": "tsc --project tsconfig.main.json",
    "build": "npm run build:main && npm run build:renderer",
    "dist:win": "npm run build && electron-builder --win",
    "dist:win:nsis": "npm run build && electron-builder --win nsis",
    "package:windows": "npm run build && powershell -NoProfile -ExecutionPolicy Bypass -File ../../scripts/package_pos_windows.ps1",
    "package:windows:dir": "npm run build && powershell -NoProfile -ExecutionPolicy Bypass -File ../../scripts/package_pos_windows.ps1 -SkipMsix",
    "release:windows": "npm run build && powershell -NoProfile -ExecutionPolicy Bypass -File ../../scripts/package_pos_windows.ps1 -RequireSigning",
    "dev": "vite",
    "start": "electron .",
    "typecheck:visual": "tsc --project tsconfig.visual.json --noEmit",
    "visual:build": "vite build --config vite.visual.config.ts",
    "visual:serve": "npm run visual:build && vite preview --config vite.visual.config.ts",
    "visual": "playwright test --project=console-1280 --workers=1 && playwright test --project=console-1024 --workers=1",
    "visual:update": "playwright test --update-snapshots --project=console-1280 --workers=1 && playwright test --update-snapshots --project=console-1024 --workers=1"
  },
  "dependencies": {
    "@dawatrace/shared": "*"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "electron": "^43.2.0",
    "electron-builder": "^25.1.8",
    "jsdom": "25.0.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "typescript": "5.7.3",
    "vite": "^8.1.5",
    "vitest": "^4.1.10"
  },
  "author": {
    "name": "Esenai Group Ltd"
  }
}
