apps/*/dist/

# Visual-regression working files. Baselines under visual/__screenshots__/linux/
# are committed and are captured only by the CI `visual` job; baselines for any
# other platform are local scratch and must not be committed, because font
# rasterisation differences would make them fail for everyone else.
apps/pos-windows/visual/__screenshots__/darwin/
apps/pos-windows/visual/__screenshots__/win32/
apps/pos-windows/test-results/
apps/pos-windows/playwright-report/
apps/pos-windows/release/
apps/pos-android/android/.gradle/
apps/pos-android/android/app/build/
# Native build output: compiled .o objects, ninja state and CMake caches. Around
# 9 MB of binaries per configure, and regenerated on every build.
apps/pos-android/android/app/.cxx/
apps/pos-android/.metro-health-check*
*.aab
*.apk
*.keystore
*.jks

# Windows-side virtualenv (companion to the .venv/ and venv/ rules above).
# Created by a Windows checkout at D:\DHA; contains no project source.
.venv-win/

# Stray command-output captures at repository root.
/seed_output.txt
/hq_test_output.txt
/count_output.txt

# Word export of the end-to-end guide is a build artefact; regenerate with
# scripts/docs/build_user_guide_docx.js rather than committing a binary that
# silently drifts from docs/TIBATRACE_USER_GUIDE.md.
docs/exports/
