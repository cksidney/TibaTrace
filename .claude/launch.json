{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "visual-harness",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "visual:serve",
        "--workspace",
        "@dawatrace/pos-windows"
      ],
      "port": 4173
    },
    {
      "name": "hq-web",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev",
        "--workspace",
        "@dawatrace/hq-web"
      ],
      "port": 5173
    },
    {
      "name": "backend",
      "runtimeExecutable": ".venv/bin/python",
      "runtimeArgs": [
        "backend/manage.py",
        "runserver",
        "127.0.0.1:8000"
      ],
      "port": 8000,
      "env": {
        "DAWATRACE_REDIS_URL": "locmem://",
        "DAWATRACE_CELERY_TASK_ALWAYS_EAGER": "1"
      }
    },
    {
      "name": "pos-windows",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev",
        "--workspace",
        "@dawatrace/pos-windows",
        "--",
        "--port",
        "5174",
        "--strictPort"
      ],
      "port": 5174
    }
  ]
}