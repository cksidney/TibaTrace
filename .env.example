DAWATRACE_ENV=development
DAWATRACE_SECRET_KEY=replace-with-a-development-only-key
DAWATRACE_ALLOWED_HOSTS=localhost,127.0.0.1
DAWATRACE_DATABASE_URL=postgresql://dawatrace:dawatrace@localhost:5433/dawatrace
DAWATRACE_REDIS_URL=redis://localhost:6380/0
DAWATRACE_CELERY_BROKER_URL=redis://localhost:6380/1
DAWATRACE_CELERY_RESULT_BACKEND=redis://localhost:6380/2
DAWATRACE_OBJECT_STORAGE_BACKEND=local
DAWATRACE_OBJECT_STORAGE_ROOT=./media/clinical
DAWATRACE_OBJECT_SIGNING_KEY=replace-with-an-independent-signing-key
DAWATRACE_FHIR_WRITE_INTERACTIONS_ENABLED=false
DAWATRACE_FHIR_SEARCH_MAX_COUNT=100
DAWATRACE_FHIR_BUNDLE_MAX_ENTRIES=100
DAWATRACE_FHIR_TERMINOLOGY_EXPANSION_MAX=200
DAWATRACE_FHIR_TERMINOLOGY_EXPANSION_ABSOLUTE_MAX=10000
DAWATRACE_FHIR_TERMINOLOGY_EXPANSION_TIMEOUT_SECONDS=5
DAWATRACE_FHIR_TERMINOLOGY_EXPANSION_CACHE_SECONDS=300
DAWATRACE_FHIR_ALLOWED_ABSOLUTE_REFERENCE_HOSTS=localhost,127.0.0.1
DAWATRACE_CORS_ALLOWED_ORIGINS=http://localhost:3000
DAWATRACE_SECURE_SSL_REDIRECT=false
