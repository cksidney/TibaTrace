# Copy to .env.production and replace every <...> value using the managed secret store.
TIBATRACE_HOST=tibatrace.esenai.co.ke
ACME_EMAIL=<operations-email@esenai.co.ke>
DAWATRACE_IMAGE=<registry>/tibatrace-backend:<immutable-image-tag>
TIBATRACE_HQ_IMAGE=<registry>/tibatrace-hq-web:<immutable-image-tag>

# Required only when using docker-compose.shared-caddy.yml. The port binds to
# loopback and is consumed by the server's existing shared Caddy instance.
TIBATRACE_API_PORT=28110
TIBATRACE_HQ_PORT=28111

DJANGO_SETTINGS_MODULE=dawatrace.settings.production
DAWATRACE_ENV=production
DAWATRACE_SECRET_KEY=<generated-django-secret-key>
DAWATRACE_OBJECT_SIGNING_KEY=<generated-independent-object-signing-key>
# Store the versioned 32-byte base64url AES keys in the protected deployment
# secret file. Keep old keys until every object and retained backup is migrated.
DAWATRACE_DOCUMENT_ENCRYPTION_KEYS='{"key-2026-10":"<base64url-encoded-32-byte-key>"}'
DAWATRACE_DOCUMENT_ENCRYPTION_ACTIVE_KEY_ID=key-2026-10
DAWATRACE_ALLOWED_HOSTS=tibatrace.esenai.co.ke
DAWATRACE_CSRF_TRUSTED_ORIGINS=https://tibatrace.esenai.co.ke
DAWATRACE_CORS_ALLOWED_ORIGINS=
DAWATRACE_BEHIND_TLS_PROXY=true
DAWATRACE_SECURE_SSL_REDIRECT=true

# Use a managed PostgreSQL service with TLS enforced. Prefer verify-full when
# the provider supplies a CA certificate to the runtime.
DAWATRACE_DATABASE_URL=postgresql://<username>:<password>@<database-host>:5432/<database-name>
DAWATRACE_DATABASE_SSLMODE=verify-full

# Use a managed Redis endpoint. Keep the database numbers isolated by purpose.
DAWATRACE_REDIS_URL=rediss://<redis-host>:6379/0
DAWATRACE_CELERY_BROKER_URL=rediss://<redis-host>:6379/1
DAWATRACE_CELERY_RESULT_BACKEND=rediss://<redis-host>:6379/2

# Docker named volumes are not encrypted by Compose. Use an encrypted host
# volume and configure it at the infrastructure layer as defense in depth.
# Application encryption protects newly stored object bytes. Production uploads
# also require a scanner configured to return CLEAN before use.
DAWATRACE_OBJECT_STORAGE_BACKEND=local
DAWATRACE_OBJECT_STORAGE_ROOT=/data/clinical
# Private ClamAV INSTREAM service. Keep port 3310 off the public network.
# Uploads fail closed until it returns CLEAN. Do not point this at a public service.
DAWATRACE_MALWARE_SCANNER_HOST=
DAWATRACE_MALWARE_SCANNER_PORT=3310

DAWATRACE_FHIR_PUBLIC_BASE_URL=https://tibatrace.esenai.co.ke/api/fhir/r4/
DAWATRACE_FHIR_WRITE_INTERACTIONS_ENABLED=false
DAWATRACE_FHIR_ALLOWED_ABSOLUTE_REFERENCE_HOSTS=tibatrace.esenai.co.ke
DAWATRACE_FHIR_SEARCH_MAX_COUNT=100
DAWATRACE_FHIR_BUNDLE_MAX_ENTRIES=100
DAWATRACE_FHIR_TERMINOLOGY_EXPANSION_MAX=200
DAWATRACE_FHIR_TERMINOLOGY_EXPANSION_ABSOLUTE_MAX=10000
DAWATRACE_FHIR_TERMINOLOGY_EXPANSION_TIMEOUT_SECONDS=5
DAWATRACE_FHIR_TERMINOLOGY_EXPANSION_CACHE_SECONDS=300
DAWATRACE_LOG_LEVEL=INFO

# Tenant-isolated checkout adapters; credentials are server environment refs.
# Configure tenant/branch providers following docs/POS_PAYMENT_WORKFLOW_GUIDE.md.
TIBATRACE_CHECKOUT_CONNECTIONS={}

# Explicit per-tenant clinical feed configuration; disabled until commissioned.
# See docs/POS_RX_INTAKE_GUIDE.md for adapter and identity mapping requirements.
TIBATRACE_RX_CONNECTIONS={}
