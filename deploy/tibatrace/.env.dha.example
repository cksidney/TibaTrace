# Merge into the server's protected environment; do not commit credential values.
# Ordered Fernet key list: first encrypts, remaining keys decrypt old journals.
TIBATRACE_DHA_DATA_KEYS=[]
# Operations are restricted by BOTH this server policy and each connection's allow-list.
# Add the assigned production host only after DHA confirms it.
TIBATRACE_DHA_ALLOWED_HOSTS=ilm-dev.dha.go.ke
TIBATRACE_DHA_ENVIRONMENT_BASES={"SANDBOX":["https://ilm-dev.dha.go.ke/uat-middleware/api/v1"],"PRODUCTION":[]}
TIBATRACE_DHA_CALLBACK_BASE_URL=https://tibatrace.esenai.co.ke
# Separate references per tenant/branch/environment. Values are intentionally blank.
TIBATRACE_APEX_DHA_SANDBOX_CLIENT_ID=
TIBATRACE_APEX_DHA_SANDBOX_CLIENT_SECRET=
TIBATRACE_APEX_DHA_SANDBOX_CALLBACK_SECRET=
