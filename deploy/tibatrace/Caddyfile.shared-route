tibatrace.esenai.co.ke {
	encode zstd gzip

	header {
		-Server
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "same-origin"
	}

	reverse_proxy 172.17.0.1:28110 {
		header_up Host {host}
		header_up X-Real-IP {remote_host}
		header_up X-Request-Id {http.request.id}
	}
}
