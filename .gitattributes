# Normalise all text files to LF in the repository and in the working tree.
# Added after a Windows filesystem round-trip silently CRLF-converted
# App.tsx, registry_init.py and pos.js, producing a ~7,700-line phantom diff.
* text=auto eol=lf

# Windows batch files must keep CRLF or cmd.exe can mis-parse them.
*.bat  text eol=crlf
*.cmd  text eol=crlf

# POSIX shell and Gradle wrapper stay LF regardless of platform.
*.sh      text eol=lf
gradlew   text eol=lf

# Binary assets: never diff, never EOL-convert.
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.ico  binary
*.pdf  binary
*.woff  binary
*.woff2 binary
*.ttf  binary
*.otf  binary
*.keystore binary
*.jks  binary
*.apk  binary
*.aab  binary

# Generated lockfile: collapsed in review UIs, but diffs stay inspectable
# (do NOT use -diff here; it hides real dependency changes from git diff).
package-lock.json linguist-generated=true
