DAWATRACE_ENV=test
DAWATRACE_SECRET_KEY=test-only-not-a-secret
DAWATRACE_DATABASE_URL=sqlite:///test.sqlite3
DAWATRACE_REDIS_URL=locmem://
DAWATRACE_CELERY_TASK_ALWAYS_EAGER=true
DAWATRACE_OBJECT_STORAGE_BACKEND=local
DAWATRACE_OBJECT_STORAGE_ROOT=/tmp/dawatrace-test-documents
DAWATRACE_OBJECT_SIGNING_KEY=test-document-signing-key
DAWATRACE_FHIR_WRITE_INTERACTIONS_ENABLED=true
